{
    "name": "yireo/magento2-extensionchecker-cli",
    "license": "OSL-3.0",
    "type": "magento2-module",
    "version": "0.0.3",
    "homepage": "https://github.com/yireo/Yireo_ExtensionCheckerCli",
    "description": "Add-on to Yireo_ExtensionChecker to run standalone",
    "keywords": [
        "composer-installer",
        "magento"
    ],
    "authors": [
        {
            "name": "Jisse Reitsma (Yireo)",
            "email": "jisse@yireo.com"
        }
    ],
    "require": {
        "yireo/magento2-extensionchecker": "*"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\ExtensionCheckerCli\\": ""
        },
        "files": [
            "cli_commands.php"
        ]
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
